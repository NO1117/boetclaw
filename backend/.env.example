# LLM Provider (openai | anthropic | google_genai | ollama)
LLM_PROVIDER=openai
LLM_MODEL=qwen3.6-35b-a3b
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GOOGLE_API_KEY=

# LangSmith (optional, for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=boetclaw

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MCP Servers (JSON)
# MCP_SERVERS={"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}}

# Gateway - DingTalk (HMAC-SHA256 via timestamp + sign headers when secret set)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_WEBHOOK_SECRET=

# Gateway - Feishu (body token / header.token checked when set; no encrypt-key support)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Gateway - QQ (OneBot / NapCat: Bearer secret or X-Signature sha1= HMAC when set)
QQ_WEBHOOK_SECRET=

# Gateway - Telegram
TELEGRAM_BOT_TOKEN=
# Optional secret_token from setWebhook; checked against X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Gateway rate limiting (0 = disabled)
GATEWAY_RATE_LIMIT_PER_MINUTE=0

# Workspace
WORKSPACE_DIR=./workspace
# Max LAS upload size in bytes (10MB by default)
LAS_UPLOAD_MAX_BYTES=10485760

# LangGraph checkpoints (sqlite is persistent; memory is explicit non-restart fallback)
CHECKPOINT_BACKEND=sqlite
# Directory containing one isolated SQLite database per Agent
CHECKPOINT_SQLITE_PATH=./workspace/checkpoints

# API auth (empty = open for local dev)
API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=0
CONSOLE_PASSWORD=
CONSOLE_JWT_SECRET=
CONSOLE_JWT_TTL_MINUTES=480

# Security (ToolGuard)
TOOL_GUARD_ENABLED=true
TOOL_GUARD_LEVEL=smart
TOOL_GUARD_DENIED_TOOLS=
FILE_GUARD_DENY_DIRS=.env,.git,.ssh,.qwenpaw.secret

# Multi-agent
DEFAULT_AGENT_ID=default
AGENT_IDLE_TTL_MINUTES=30

# Scheduler / Heartbeat
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MINUTES=120
HEARTBEAT_PROMPT=汇总我的待办

# Provider (local model)
OLLAMA_BASE_URL=http://localhost:11434
PROVIDER_RATE_LIMIT_PER_MINUTE=0

# Provider credential vault (AES-256-GCM; required to save API keys via console / vault)
# Must be a cryptographically random 32-byte value, encoded as standard or URL-safe base64
# (or 64-char hex). Generate locally, inject via environment or secrets manager only.
# NEVER commit a real value to git, CI artifacts, or shared .env files.
# Example generation (run locally, paste result into deployment env — not into this file):
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
BOETCLAW_MASTER_KEY=

# Speech / Voice (STT/TTS — decoupled from chat models; falls back to OPENAI_* when unset)
SPEECH_PROVIDER=openai_compatible
# SPEECH_API_KEY=
# SPEECH_BASE_URL=
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=tts-1
SPEECH_TTS_VOICE=alloy
SPEECH_TTS_FORMAT=mp3
SPEECH_MAX_UPLOAD_BYTES=26214400
SPEECH_MAX_DURATION_SECONDS=600
SPEECH_MAX_TEXT_CHARS=4096
SPEECH_RATE_LIMIT_PER_MINUTE=30
SPEECH_MAX_CONCURRENT=4
SPEECH_TIMEOUT_SECONDS=120
SPEECH_TEMP_TTL_SECONDS=300

# Plugins (comma-separated names under plugins_ext/; empty = none enabled)
ENABLED_PLUGINS=

# Memory & context
MEMORY_BACKEND=file
CONTEXT_SUMMARIZATION_ENABLED=false
CONTEXT_KEEP_MESSAGES=20
CONTEXT_TRIGGER_TOKENS=4000

# Graph cache (isolated per-request agent graphs)
GRAPH_CACHE_MAX_SIZE=32
GRAPH_CACHE_TTL_SECONDS=900

# i18n
LANG=zh

# Observability
OTEL_ENABLED=true
OTEL_CONSOLE_EXPORTER=false
TRACE_PERSIST_ENABLED=true
TRACE_PERSIST_MAX_LINES=50000
